---
import { heroDioramaConfig, scrollWorldScenes } from '../data/siteContent';

const allScenesPayload = [
  {
    id: heroDioramaConfig.id,
    beatNumber: heroDioramaConfig.beatNumber,
    stillImage: heroDioramaConfig.stillImage,
    fallbackStill: heroDioramaConfig.fallbackStill,
    introVideo: heroDioramaConfig.introVideo,
    diveVideo: heroDioramaConfig.diveVideo,
    connectorVideo: heroDioramaConfig.connectorVideo,
  },
  ...scrollWorldScenes.map((s) => ({
    id: s.id,
    beatNumber: s.beatNumber,
    stillImage: s.stillImage,
    fallbackStill: s.fallbackStill,
    diveVideo: s.diveVideo,
    connectorVideo: s.connectorVideo,
  })),
];

const allHotspotGroups = [
  { id: heroDioramaConfig.id, hotspots: heroDioramaConfig.hotspots },
  ...scrollWorldScenes.map((s) => ({ id: s.id, hotspots: s.hotspots })),
];

const railChapters = [
  { beatNumber: '00', chapterLabel: 'Inicio' },
  ...scrollWorldScenes.map((s) => ({
    beatNumber: s.beatNumber,
    chapterLabel: s.chapterLabel,
  })),
];
---

<section
  id="inicio"
  class="diorama-world-track"
  aria-labelledby="hero-heading"
  data-sw-track
  data-sw-scenes={JSON.stringify(allScenesPayload)}
>
  <!-- Ancla intermedia para enlaces directos al recorrido 360° -->
  <div id="recorrido-360" class="recorrido-anchor" aria-hidden="true"></div>

  <div class="diorama-sticky-viewport">
    <!-- 1. Lienzo Multi-Plano 3D (Hero Beat 00 + 6 Mundos de Especialidad) -->
    <canvas class="diorama-canvas" data-sw-canvas aria-hidden="true"></canvas>

    <!-- 2. Cortina Diagonal Dinámica del Hero (Se repliega al hacer scroll) -->
    <div class="hero-diagonal-shutter" data-sw-hero-shutter aria-hidden="true">
      <div class="shutter-grid-overlay"></div>
      <div class="shutter-laser-edge"></div>
    </div>

    <!-- 3. Capa de Tarjetas 3D del Hero (Beat 00) y Hotspots Técnicos CAD (Beats 01..06) -->
    <div class="hotspots-stage">
      {
        allHotspotGroups.map((group, gIdx) => (
          <div
            class:list={['hotspot-group', { 'is-active': gIdx === 0 }]}
            data-sw-hotspot-group={gIdx}
          >
            {group.hotspots.map((hs, hIdx) => (
              <div
                class:list={[
                  'tech-hotspot',
                  `dir-${hs.direction}`,
                  { 'is-card-3d': Boolean(hs.image) },
                ]}
                style={`left: ${hs.x}%; top: ${hs.y}%; --hs-delay: ${hIdx * 160}ms;`}
                data-sw-hotspot
                data-hx={hs.x}
                data-hy={hs.y}
                data-depth={hs.depth}
                data-card3d={hs.image ? 'true' : 'false'}
              >
                {hs.image ? (
                  <a
                    href={hs.href || '#servicios'}
                    class="hero-card-3d"
                    style={`--card-delay: ${120 + hIdx * 160}ms;`}
                  >
                    <span class="hc3d-glare" aria-hidden="true"></span>

                    <div class="hc3d-media">
                      <picture>
                        <source srcset={hs.image} type="image/webp" />
                        <img
                          src={hs.fallbackImage || hs.image}
                          alt={hs.imageAlt || hs.label}
                          width="320"
                          height="180"
                          loading="eager"
                          decoding="async"
                        />
                      </picture>
                      <span class="hc3d-media-shade" aria-hidden="true"></span>
                      <span class="hc3d-badge">
                        <span class="hc3d-dot" aria-hidden="true"></span>
                        <span>{hs.code}</span>
                      </span>
                      <span class="hc3d-arrow" aria-hidden="true">↗</span>
                    </div>

                    <div class="hc3d-body">
                      <strong class="hc3d-title">{hs.label}</strong>
                      <span class="hc3d-detail">{hs.detail}</span>
                    </div>
                  </a>
                ) : (
                  <>
                    <!-- Nodo focal pulsante -->
                    <span class="hs-node" aria-hidden="true">
                      <span class="hs-ring"></span>
                      <span class="hs-core"></span>
                    </span>

                    <!-- Línea conectora CAD a 45° -->
                    <svg
                      class="hs-leader"
                      width="64"
                      height="28"
                      viewBox="0 0 64 28"
                      fill="none"
                      aria-hidden="true"
                    >
                      {hs.direction === 'right' ? (
                        <path
                          class="hs-leader-path"
                          d="M2 26 L20 6 L62 6"
                          stroke="#FF6B00"
                          stroke-width="1.6"
                          stroke-linecap="round"
                        />
                      ) : (
                        <path
                          class="hs-leader-path"
                          d="M62 26 L44 6 L2 6"
                          stroke="#FF6B00"
                          stroke-width="1.6"
                          stroke-linecap="round"
                        />
                      )}
                    </svg>

                    <!-- Etiqueta técnica flotante -->
                    <div class="hs-card">
                      <span class="hs-code">{hs.code}</span>
                      <strong class="hs-label">{hs.label}</strong>
                      <span class="hs-detail">{hs.detail}</span>
                    </div>
                  </>
                )}
              </div>
            ))}
          </div>
        ))
      }
    </div>

    <!-- 4. HUD Superior de Telemetría (Aparece al sumergirse desde el Hero) -->
    <div class="sw-hud-top" data-sw-hud-top>
      <div class="container-pro sw-hud-top-inner">
        <div class="sw-telemetry">
          <span class="sw-live-pill">
            <span class="sw-live-dot"></span>
            <span data-sw-phase>DIORAMA MULTI-PLANO · 360° PRO</span>
          </span>
          <span class="sw-divider" aria-hidden="true"></span>
          <span class="sw-coord">
            GIRO <strong data-sw-degree>000°</strong>
          </span>
          <span class="sw-divider hide-sm" aria-hidden="true"></span>
          <span class="sw-counter hide-sm" data-sw-counter>01 / 06</span>
        </div>

        <a href="#servicios" class="sw-skip-btn">
          <span>Saltar al portafolio</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <!-- 5. Contenido Ejecutivo del Hero (Beat 00 — Se abre en perspectiva al hacer scroll) -->
    <div class="hero-stage-wrap" data-sw-hero-copy>
      <div class="container-pro">
        <div class="hero-content">
          <!-- Tarjetas 3D Compactas para Móvil/Tablet (<960px) sobre la ventana de video -->
          <div class="hero-mobile-cards-3d" aria-label="Pilares estratégicos 360° Pro">
            {
              heroDioramaConfig.hotspots.map((hs, idx) => (
                <a
                  href={hs.href || '#servicios'}
                  class="hm-card-3d"
                  style={`--hm-delay: ${140 + idx * 130}ms;`}
                >
                  {hs.image && (
                    <div class="hm-card-thumb">
                      <img
                        src={hs.image}
                        alt={hs.imageAlt || hs.label}
                        width="80"
                        height="54"
                        loading="eager"
                        decoding="async"
                      />
                    </div>
                  )}
                  <div class="hm-card-info">
                    <span class="hm-card-code">{hs.code}</span>
                    <strong class="hm-card-title">{hs.label}</strong>
                  </div>
                </a>
              ))
            }
          </div>

          <div class="eyebrow hero-eyebrow">
            <span class="eyebrow-line" aria-hidden="true"></span>
            <span>SOLUCIONES INTEGRALES PARA TUS PROYECTOS</span>
          </div>

          <h1 id="hero-heading" class="heading-h1 hero-title">
            IDEAS QUE <span class="text-accent hero-accent-glow">CONSTRUYEN</span> GRANDES RESULTADOS
          </h1>

          <p class="body-large hero-copy">
            En <strong>360° Pro Soluciones Integrales S.A.S.</strong> integramos conocimientos,
            experiencia y capacidades profesionales para ofrecer soluciones a las necesidades de
            empresas, instituciones, entidades públicas y clientes particulares. Desarrollamos
            servicios en arquitectura e ingeniería civil, construcción, mantenimiento y
            adecuaciones, publicidad y artes gráficas, suministros, logística operativa y
            consultoría técnica y ambiental.
          </p>

          <blockquote class="hero-support-quote">
            Un solo aliado para múltiples soluciones.
          </blockquote>

          <div class="hero-cta-group">
            <a href="#servicios" class="btn-primary-pro hero-btn">
              <span>Conoce nuestros servicios</span>
              <span class="btn-arrow-circle" aria-hidden="true">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </span>
            </a>

            <a href="#contacto" class="btn-secondary-outline hero-btn">
              Solicitar cotización
            </a>
          </div>

          <div class="hero-scroll-invitation">
            <span class="cue-mouse" aria-hidden="true">
              <span class="cue-wheel"></span>
            </span>
            <span>Haz scroll para sumergirte en el recorrido 3D · 6 especialidades</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 6. Tarjetas Sincronizadas de Especialidades (Beats 01..06) -->
    <div class="container-pro sw-beats-stage">
      {
        scrollWorldScenes.map((scene, idx) => (
          <article
            class:list={[
              'sw-beat-card',
              scene.hudPosition === 'right' ? 'align-right' : 'align-left',
            ]}
            data-sw-beat={idx}
            aria-hidden="true"
          >
            <div class="sw-beat-header">
              <span class="sw-beat-num">{scene.beatNumber}</span>
              <span class="sw-beat-eyebrow">{scene.eyebrow}</span>
            </div>

            <h2 class="sw-beat-title">
              {scene.title} <span class="text-accent">{scene.highlight}</span>
            </h2>

            <p class="sw-beat-desc">{scene.description}</p>

            <div class="sw-beat-tags">
              {scene.tags.map((tag) => (
                <span class="sw-beat-tag">{tag}</span>
              ))}
            </div>

            <div class="sw-beat-footer">
              <span class="sw-beat-metrics">{scene.metrics}</span>
              <a
                href="#contacto"
                class="sw-beat-cta"
                data-select-service={scene.serviceValue}
              >
                <span>Cotizar línea</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <!-- 7. Riel Inferior Interactivo (00 Inicio + 01..06 Especialidades) -->
    <div class="sw-hud-bottom">
      <div class="container-pro">
        <div class="sw-scrub-rail" role="tablist" aria-label="Línea de tiempo del mundo 360°">
          <div class="sw-chapter-list">
            {
              railChapters.map((ch, idx) => (
                <button
                  type="button"
                  class:list={['sw-chapter-btn', { 'is-active': idx === 0 }]}
                  data-sw-jump={idx}
                  aria-current={idx === 0 ? 'step' : 'false'}
                >
                  <span class="sw-ch-num">{ch.beatNumber}</span>
                  <span class="sw-ch-label">{ch.chapterLabel}</span>
                </button>
              ))
            }
          </div>
          <div class="sw-timeline-bar" aria-hidden="true">
            <div class="sw-timeline-fill" data-sw-progress-fill></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Pista vertical unificada (Hero Beat 00 + 6 Capítulos) */
  .diorama-world-track {
    position: relative;
    z-index: 1;
    height: 540vh;
    background-color: #061524;
  }

  @media (min-width: 1024px) {
    .diorama-world-track {
      height: 640vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .diorama-world-track {
      height: 170vh;
    }
  }

  .recorrido-anchor {
    position: absolute;
    top: 16%;
    left: 0;
    width: 1px;
    height: 1px;
    scroll-margin-top: 90px;
  }

  .diorama-sticky-viewport {
    position: sticky;
    top: 74px;
    width: 100%;
    height: calc(100vh - 74px);
    height: calc(100svh - 74px);
    min-height: 520px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  @media (min-width: 1024px) {
    .diorama-sticky-viewport {
      top: 82px;
      height: calc(100vh - 82px);
      height: calc(100svh - 82px);
      min-height: 580px;
    }
  }

  .diorama-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
  }

  /* Cortina Diagonal Dinámica del Hero:
     En móvil deja libre la ventana superior (0..38%) para que el video en vivo luzca nítido. */
  .hero-diagonal-shutter {
    position: absolute;
    inset: -8% -40%;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(6, 21, 36, 0.04) 0%,
      rgba(6, 21, 36, 0.14) 34%,
      rgba(10, 34, 57, 0.72) 54%,
      rgba(6, 21, 36, 0.92) 78%,
      rgba(6, 21, 36, 0.96) 100%
    );
    will-change: transform, opacity;
  }

  @media (min-width: 960px) {
    .hero-diagonal-shutter {
      background: linear-gradient(
        105deg,
        #0A2239 0%,
        #0A2239 46%,
        rgba(10, 34, 57, 0.82) 58%,
        rgba(10, 34, 57, 0.12) 76%,
        rgba(10, 34, 57, 0) 94%
      );
    }
  }

  .shutter-grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 58px 58px;
    mask-image: linear-gradient(100deg, rgba(0, 0, 0, 0.85) 0%, transparent 56%);
    -webkit-mask-image: linear-gradient(100deg, rgba(0, 0, 0, 0.85) 0%, transparent 56%);
  }

  .shutter-laser-edge {
    display: none;
  }

  /* Capa de Tarjetas 3D del Hero y Hotspots Técnicos */
  .hotspots-stage {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    perspective: 1200px;
    display: none;
  }

  @media (min-width: 960px) {
    .hotspots-stage {
      display: block;
    }
  }

  .hotspot-group {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform-style: preserve-3d;
    transition: opacity 0.2s linear;
  }

  .tech-hotspot {
    position: absolute;
    display: flex;
    align-items: center;
    will-change: transform;
  }

  .tech-hotspot.is-card-3d {
    margin-left: -136px;
    margin-top: -68px;
    transform-style: preserve-3d;
    perspective: 1100px;
  }

  /* Tarjetas Flotantes 3D Temáticas del Hero (Beat 00) */
  .hero-card-3d {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 272px;
    padding: 8px;
    border-radius: 16px;
    background: linear-gradient(
      145deg,
      rgba(12, 39, 66, 0.88) 0%,
      rgba(6, 21, 36, 0.94) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow:
      0 24px 50px -12px rgba(2, 8, 18, 0.78),
      0 0 0 1px rgba(255, 107, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    text-decoration: none;
    transform-style: preserve-3d;
    pointer-events: none;
    animation: heroCard3dEnter 1.1s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: var(--card-delay, 120ms);
    transition:
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .hotspot-group.is-active .hero-card-3d {
    pointer-events: auto;
  }

  @keyframes heroCard3dEnter {
    0% {
      opacity: 0;
      transform: translate3d(76px, 44px, -150px) rotateY(-32deg) rotateX(18deg) scale(0.82);
      filter: blur(8px);
    }
    68% {
      opacity: 1;
      transform: translate3d(-4px, -3px, 16px) rotateY(4deg) rotateX(-2deg) scale(1.02);
      filter: blur(0px);
    }
    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0) rotateY(0deg) rotateX(0deg) scale(1);
      filter: blur(0px);
    }
  }

  .hero-card-3d:hover {
    border-color: rgba(255, 107, 0, 0.82);
    box-shadow:
      0 30px 64px -10px rgba(0, 0, 0, 0.85),
      0 0 28px rgba(255, 107, 0, 0.36),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .hc3d-glare {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      220px circle at var(--glare-x, 50%) var(--glare-y, 30%),
      rgba(255, 255, 255, 0.18),
      rgba(255, 107, 0, 0.08) 42%,
      transparent 75%
    );
    mix-blend-mode: screen;
    z-index: 3;
  }

  .hc3d-media {
    position: relative;
    width: 100%;
    height: 88px;
    border-radius: 11px;
    overflow: hidden;
    background: #061524;
    transform: translateZ(16px);
    box-shadow: 0 10px 22px -8px rgba(0, 0, 0, 0.65);
  }

  .hc3d-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.03);
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-card-3d:hover .hc3d-media img {
    transform: scale(1.12);
  }

  .hc3d-media-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(6, 21, 36, 0.38) 0%,
      rgba(6, 21, 36, 0.08) 45%,
      rgba(6, 21, 36, 0.78) 100%
    );
  }

  .hc3d-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(6, 21, 36, 0.82);
    border: 1px solid rgba(255, 107, 0, 0.55);
    backdrop-filter: blur(8px);
    font-family: var(--font-heading);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    color: #FFFFFF;
  }

  .hc3d-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
  }

  .hc3d-arrow {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(6, 21, 36, 0.76);
    border: 1px solid rgba(255, 255, 255, 0.24);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .hero-card-3d:hover .hc3d-arrow {
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: translate3d(2px, -2px, 0) scale(1.08);
  }

  .hc3d-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 8px 5px;
    transform: translateZ(26px);
  }

  .hc3d-title {
    font-family: var(--font-heading);
    font-size: 0.86rem;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.22;
    letter-spacing: -0.01em;
  }

  .hc3d-detail {
    font-size: 0.73rem;
    color: #CBD5E1;
    line-height: 1.32;
  }

  .hs-node {
    position: relative;
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hs-core {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-accent);
    border: 1.5px solid #FFFFFF;
    box-shadow: 0 0 12px var(--color-accent);
  }

  .hs-ring {
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 107, 0, 0.75);
    animation: hsSonar 2.4s infinite cubic-bezier(0.16, 1, 0.3, 1);
    animation-delay: var(--hs-delay, 0ms);
  }

  @keyframes hsSonar {
    0% {
      transform: scale(0.65);
      opacity: 0.95;
    }
    100% {
      transform: scale(1.9);
      opacity: 0;
    }
  }

  .hs-leader {
    flex-shrink: 0;
    margin-top: -18px;
    overflow: visible;
  }

  .tech-hotspot.dir-right {
    flex-direction: row;
  }

  .tech-hotspot.dir-left {
    flex-direction: row-reverse;
    transform-origin: right center;
  }

  .tech-hotspot.dir-left .hs-node {
    margin-left: -2px;
  }

  .hs-leader-path {
    stroke-dasharray: 84;
    stroke-dashoffset: 84;
    transition: stroke-dashoffset 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--hs-delay, 0ms);
  }

  .hotspot-group.is-active .hs-leader-path {
    stroke-dashoffset: 0;
  }

  .hs-card {
    margin-top: -32px;
    padding: 8px 13px;
    border-radius: 11px;
    background: rgba(6, 21, 36, 0.84);
    border: 1px solid rgba(255, 107, 0, 0.42);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 12px 28px -8px rgba(0, 0, 0, 0.55);
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 175px;
    max-width: 235px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.45s ease, transform 0.45s ease;
    transition-delay: calc(var(--hs-delay, 0ms) + 120ms);
  }

  .hotspot-group.is-active .hs-card {
    opacity: 1;
    transform: translateY(0);
  }

  .hs-code {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }

  .hs-label {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.25;
  }

