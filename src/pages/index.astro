---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroWorldDiorama from '../components/HeroWorldDiorama.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
---

<Layout>
  <!-- 3.1 Barra de Navegación Corporativa -->
  <Header />

  <main class="stack-stage-bg">
    <!-- 3.2 Hero Unificado + Diorama Multi-Plano 3D con Hotspots Técnicos (#inicio / #recorrido-360) -->
    <HeroWorldDiorama />

    <!-- CAPA APILADA 1: Nuestros Servicios + Consultoría Técnica (#servicios) -->
    <div class="stack-flow-anchor" data-anchor-for="servicios" aria-hidden="true"></div>
    <div class="stack-sheet stack-sheet-surface-ice" style="z-index: 10;" data-stack-sheet>
      <div class="stack-sheet-inner">
        <div class="diagonal-curtain" aria-hidden="true">
          <svg viewBox="0 0 1440 72" preserveAspectRatio="none">
            <polygon points="0,72 1440,6 1440,72" fill="#F4F7FA"></polygon>
            <line
              x1="0"
              y1="72"
              x2="1440"
              y2="6"
              stroke="#FF6B00"
              stroke-width="2.5"
              vector-effect="non-scaling-stroke"
            ></line>
          </svg>
        </div>
        <div class="stack-sheet-clip">
          <Services />
          <div class="stack-dim-veil" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <!-- CAPA APILADA 2: Nosotros — Identidad, Misión/Visión y Valores (#nosotros) -->
    <div class="stack-flow-anchor" data-anchor-for="nosotros" aria-hidden="true"></div>
    <div class="stack-sheet stack-sheet-surface-white" style="z-index: 20;" data-stack-sheet>
      <div class="stack-sheet-inner">
        <div class="diagonal-curtain" aria-hidden="true">
          <svg viewBox="0 0 1440 72" preserveAspectRatio="none">
            <polygon points="0,8 1440,72 0,72" fill="#FFFFFF"></polygon>
            <line
              x1="0"
              y1="8"
              x2="1440"
              y2="72"
              stroke="rgba(10, 34, 57, 0.16)"
              stroke-width="1.5"
              vector-effect="non-scaling-stroke"
            ></line>
          </svg>
        </div>
        <div class="stack-sheet-clip">
          <About />
          <div class="stack-dim-veil" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <!-- CAPA APILADA 3: ¿Por Qué Elegirnos? — Modo Oscuro & Glassmorphism (#por-que-elegirnos) -->
    <div class="stack-flow-anchor" data-anchor-for="por-que-elegirnos" aria-hidden="true"></div>
    <div class="stack-sheet stack-sheet-surface-navy" style="z-index: 30;" data-stack-sheet>
      <div class="stack-sheet-inner">
        <div class="diagonal-curtain" aria-hidden="true">
          <svg viewBox="0 0 1440 72" preserveAspectRatio="none">
            <polygon points="0,72 1440,4 1440,72" fill="#0A2239"></polygon>
            <line
              x1="0"
              y1="72"
              x2="1440"
              y2="4"
              stroke="#FF6B00"
              stroke-width="2.5"
              vector-effect="non-scaling-stroke"
            ></line>
          </svg>
        </div>
        <div class="stack-sheet-clip">
          <WhyChooseUs />
          <div class="stack-dim-veil" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <!-- CAPA APILADA 4: Contacto y Cotizaciones + Footer Corporativo (#contacto) -->
    <div class="stack-flow-anchor" data-anchor-for="contacto" aria-hidden="true"></div>
    <div class="stack-sheet stack-sheet-surface-ice" style="z-index: 40;" data-stack-sheet>
      <div class="stack-sheet-inner">
        <div class="diagonal-curtain" aria-hidden="true">
          <svg viewBox="0 0 1440 72" preserveAspectRatio="none">
            <polygon points="0,8 1440,72 0,72" fill="#F4F7FA"></polygon>
            <line
              x1="0"
              y1="8"
              x2="1440"
              y2="72"
              stroke="#FF6B00"
              stroke-width="2"
              vector-effect="non-scaling-stroke"
            ></line>
          </svg>
        </div>
        <div class="stack-sheet-clip">
          <Contact />
          <!-- 3.8 Footer Corporativo integrado al cierre de la última capa -->
          <Footer />
        </div>
      </div>
    </div>
  </main>

  <!-- Requerimiento Técnico 3: Botón Flotante de WhatsApp (FAB) -->
  <WhatsAppFab />

  <script>
    import { ScrollWorldEngine, type EngineSceneConfig } from '../scripts/scroll-world-engine';
    import { initUIInteractions } from '../scripts/ui-interactions';

    const bootstrap = () => {
      initUIInteractions();

      const trackEl = document.querySelector<HTMLElement>('[data-sw-track]');
      if (trackEl) {
        const rawScenes = trackEl.dataset.swScenes;
        if (rawScenes) {
          const parsedScenes: EngineSceneConfig[] = JSON.parse(rawScenes);
          new ScrollWorldEngine(trackEl, parsedScenes);
        }
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
    } else {
      bootstrap();
    }
  </script>
</Layout>
